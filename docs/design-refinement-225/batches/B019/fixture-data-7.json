        {
          "id": "view",
          "label": "表示を切り替える",
          "description": "一覧とグリッド",
          "group": "PREFERENCES",
          "icon": "grid",
          "children": [
            {
              "id": "list",
              "label": "リスト表示",
              "icon": "file"
            },
            {
              "id": "grid",
              "label": "グリッド表示",
