{
  "name": "state-of-play",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "STATE OF PLAY \u2014 UI & Motion Library. Vite + TypeScript, portable React/Vanilla components.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:react": "tsc -p tsconfig.react.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:react && npm run typecheck:tools",
    "test": "node --experimental-strip-types --test tests/core.test.ts tests/delivery.test.ts tests/expansion.test.ts",
    "test:browser": "node --experimental-strip-types tests/browser.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:relocation",
    "export:parts": "node --experimental-strip-types scripts/export-parts.ts",
    "package": "node --experimental-strip-types scripts/package.ts",
    "test:relocation": "node --experimental-strip-types tests/relocation.ts"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "typescript": "5.8.3",
    "playwright": "1.63.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/node": "22.15.33"
  }
}
