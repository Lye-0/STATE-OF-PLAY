{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/shared/motion.ts",
    "src/shared/renderer.ts",
    "src/shared/toggle-controller.ts",
    "src/shared/surface-controller.ts",
    "src/parts/*/*/vanilla/*.ts",
    "src/parts/*/*/demo/*.ts"
  ]
}
